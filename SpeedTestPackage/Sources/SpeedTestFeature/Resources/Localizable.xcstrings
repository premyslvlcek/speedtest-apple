      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najde 5 nejbližších testovacích serverů, změří k nim ping přes ICMP a na nejrychlejším pak 15 s měří rychlost stahování."
