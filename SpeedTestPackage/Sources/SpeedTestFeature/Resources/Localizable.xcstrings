    "intro" : {
      "comment" : "Introduction shown before the first run.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najde 5 nejbližších testovacích serverů, změří k nim ping přes ICMP a na nejrychlejším pak měří stahování 15 s a odesílání 10 s."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the 5 closest speed test servers, pings each one over ICMP, then measures download for 15 s and upload for 10 s on the fastest."
          }
        }
      }
    },
