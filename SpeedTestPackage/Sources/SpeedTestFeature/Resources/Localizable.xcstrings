          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdá se, že nejste připojeni k internetu. Zkontrolujte Wi-Fi nebo mobilní data a zkuste to znovu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You appear to be offline. Check Wi-Fi or mobile data and try again."
